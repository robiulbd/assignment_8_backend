{
  "name": "@better-auth/infra",
  "version": "0.4.26",
  "description": "Dashboard and analytics plugin for Better Auth",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "sideEffects": false,
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --bun tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "exports": {
    ".": {
      "@infra/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "@infra/source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./email": {
      "@infra/source": "./src/email.ts",
      "types": "./dist/email.d.mts",
      "import": "./dist/email.mjs",
      "default": "./dist/email.mjs"
    },
    "./native": {
      "@infra/source": "./src/native.ts",
      "types": "./dist/native.d.mts",
      "import": "./dist/native.mjs",
      "default": "./dist/native.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "better-auth",
    "auth",
    "authentication",
    "dashboard",
    "analytics",
    "security"
  ],
  "author": "Better Auth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-auth/infrastructure.git",
    "directory": "packages/infra"
  },
  "bugs": {
    "url": "https://github.com/better-auth/infrastructure/issues"
  },
  "homepage": "https://better-auth.com",
  "devDependencies": {
    "@better-auth/kysely-adapter": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/scim": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "@infra/mocks": "0.0.0",
    "@infra/utils": "0.0.0",
    "@simplewebauthn/server": "^13.3.1",
    "@size-limit/file": "^14.3.0",
    "@types/bun": "latest",
    "@types/node": "^24.12.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "better-auth": "1.7.14",
    "expo-crypto": "^57.0.3",
    "msw": "^2.14.6",
    "playwright": "^1.63.0",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@noble/hashes": "^2.2.0",
    "@xmldom/xmldom": "^0.9.10",
    "better-call": "1.4.4",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14"
  },
  "peerDependencies": {
    "better-auth": ">=1.4.0",
    "zod": ">=4.1.12",
    "@better-auth/core": ">=1.4.0",
    "react-native": ">=0.74.0",
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "expo-constants": ">=16.0.0",
    "expo-crypto": ">=13.0.0",
    "expo-device": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "size-limit": [
    {
      "name": "index",
      "path": "dist/index.mjs",
      "limit": "90 kB"
    },
    {
      "name": "client",
      "path": "dist/client.mjs",
      "limit": "5 kB"
    },
    {
      "name": "email",
      "path": "dist/email.mjs",
      "limit": "2 kB"
    },
    {
      "name": "native",
      "path": "dist/native.mjs",
      "limit": "4 kB"
    },
    {
      "name": "all JS",
      "path": "dist/**/*.mjs",
      "limit": "105 kB"
    }
  ]
}
